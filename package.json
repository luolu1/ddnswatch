{
  "name": "ddnswatch-worker",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir dist",
    "check": "biome check . && tsc --noEmit && bun run test",
    "format": "biome check --write .",
    "test": "vitest run tests/worker.test.ts && vitest run tests/tcp-ping.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.4",
    "wrangler": "^4.28.0"
  }
}
